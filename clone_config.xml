<?xml version="1.0" encoding="UTF-8"?>
<!--
  CLONE CONFIG — настройки импорта компонентов в SchLib
  Altium Designer 26.6.0 / DelphiScript

  ВАЖНО:
  1. Сохранять этот файл в кодировке UTF-8 with BOM.
     Это необходимо для корректного чтения русских значений скриптом.
  2. Перед запуском открыть нужную библиотеку SchLib в Altium.
  3. Имена Source и Target должны соответствовать именам компонентов в библиотеке.
  4. Source — имя существующего компонента, который служит образцом.
  5. Target — имя нового компонента. Если Target указан, создаётся копия Source.
     При копировании сохраняются графика и альтернативные режимы отображения.
  6. Если Target отсутствует, параметры меняются у исходного компонента Source.
  7. Внутри задачи можно указать любое количество параметров.
     Существующий параметр изменяется, отсутствующий — добавляется.
  8. Стандартные поля обрабатываются особо:
       Description — описание компонента;
       Designator  — позиционное обозначение, например R?;
       Comment     — комментарий компонента.
     LibReference задаётся атрибутом Target, а не отдельным параметром.
  9. Остальные имена параметров считаются пользовательскими,
     например PartNumber, Tolerance, Manufacturer, Value.
 10. Для специальных XML-символов в значениях использовать:
       &amp;  вместо амперсанда
       &quot; вместо двойной кавычки
       &lt;   вместо знака меньше
       &gt;   вместо знака больше
 11. Не использовать в комментариях буквальные начала тегов задач
     или параметров: простой парсер может принять их за реальные записи.
 12. Перед массовыми изменениями рекомендуется сделать копию SchLib.

  Ниже — ПРИМЕРЫ. Замените имена компонентов и значения на свои.
  Для отключения примера удалите соответствующий блок задачи.
-->
<CloneTasks>

  <!-- ПРИМЕР 1. Создать новый компонент на основе существующего. -->
  <Task Source="RES_0603_1K0" Target="RES_0603_2K2">
    <!-- Стандартные поля компонента -->
    <Parameter Name="Description" Value="Резистор 2,2 кОм, 1%"/>
    <Parameter Name="Designator" Value="R?"/>
    <Parameter Name="Comment" Value="2.2k"/>

    <!-- Пользовательские параметры: изменить или создать -->
    <Parameter Name="PartNumber" Value="RES-0603-2K2"/>
    <Parameter Name="Tolerance" Value="1%"/>
    <Parameter Name="Manufacturer" Value="Пример производителя"/>
  </Task>

  <!-- ПРИМЕР 2. Изменить исходный компонент без клонирования. -->
  <Task Source="RES_0603_1K0">
    <Parameter Name="Tolerance" Value="5%"/>
    <Parameter Name="Description" Value="Резистор 1 кОм, 5%"/>
  </Task>

  <!-- ПРИМЕР 3. Клонировать и добавить произвольные свойства. -->
  <Task Source="CAP_0603_100N" Target="CAP_0603_220N">
    <Parameter Name="Description" Value="Конденсатор 220 нФ"/>
    <Parameter Name="Designator" Value="C?"/>
    <Parameter Name="Comment" Value="220n"/>
    <Parameter Name="Voltage" Value="50 V"/>
    <Parameter Name="Dielectric" Value="X7R"/>
  </Task>

</CloneTasks>
